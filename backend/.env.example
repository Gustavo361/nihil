# Copie estes valores para o ambiente (não commite .env com senha real).
# Local PostgreSQL:
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/nihil
DB_USERNAME=nihil
DB_PASSWORD=change-me

# Neon (após `neon deploy`): use a URL direta (UNPOOLED) convertida para JDBC.
# Exemplo de forma (valores reais ficam em .env.local / backend/.env — gitignored):
# DB_URL=jdbc:postgresql://ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# DB_USERNAME=neondb_owner
# DB_PASSWORD=<from Neon>
#
# Neon Auth (Better Auth) é provisionado via neon.ts, mas a autenticação do Nihil
# continua planejada em Spring Security — não usar NEON_AUTH_* no backend nesta etapa.
